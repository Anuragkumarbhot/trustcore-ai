# Application
APP_NAME="TRUSTCORE AI"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL) – for Termux local dev, use SQLite fallback by commenting out the PostgreSQL URL
DATABASE_URL=postgresql://trustcore:trustcore@localhost:5432/trustcore
# DATABASE_URL=sqlite:///./trustcore.db

# CORS (comma separated)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1